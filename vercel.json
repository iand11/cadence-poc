{
  "rewrites": [
    {
      "source": "/l/:slug/:view",
      "destination": "/api/l?slug=:slug&view=:view"
    },
    {
      "source": "/l/:slug",
      "destination": "/api/l?slug=:slug"
    },
    {
      "source": "/go/:slug/:service",
      "destination": "/api/go?slug=:slug&service=:service"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/spotify-plays",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/refresh-facets",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/stream-counts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/data-health",
      "schedule": "10 * * * *"
    }
  ],
  "functions": {
    "api/campaign/meta-launch.js": {
      "maxDuration": 60
    },
    "api/cron/refresh-facets.js": {
      "maxDuration": 60
    },
    "api/cron/stream-counts.js": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/streams/index.js": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/widgets/index.js": {
      "maxDuration": 60
    },
    "api/cron/data-health.js": {
      "maxDuration": 300
    },
    "api/admin/health.js": {
      "maxDuration": 120
    }
  }
}
